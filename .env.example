# Copy this file to .env and fill in your Hikvision Minmoe terminal's details.
# The IP must be reachable from wherever the asterisk container runs (host network).
HIKVISION_IP=192.168.1.50
HIKVISION_USER=admin
HIKVISION_PASS=change-me

# ISAPI relay path. door/1 is relay #1 on most Minmoe / access-control capable
# indoor stations. Change to door/2 etc. if you wired a different relay.
HIKVISION_DOOR_PATH=/ISAPI/AccessControl/RemoteControl/door/1
